<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/LinkDrop.ico</ApplicationIcon>
    <Version>1.2.1</Version>
    <AssemblyName>LinkDrop</AssemblyName>
    <RootNamespace>LinkDrop</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);.tools/**;artifacts/**;dist/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/LinkDrop.ico" /></ItemGroup>
</Project>
