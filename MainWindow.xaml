<Window x:Class="LinkDrop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LinkDrop — Twoje media, pod ręką" Width="1180" Height="850" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <DataTemplate x:Key="JobRow">
      <Border Background="#141D2B" BorderBrush="#253044" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="#293044" CornerRadius="10" Width="38" Height="42" VerticalAlignment="Top"><TextBlock Text="{Binding Symbol}" FontSize="23" Foreground="#BBA5FF" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Margin="6,0,16,0">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,5,0,9"/>
            <ProgressBar Value="{Binding Progress}" Maximum="100" Visibility="{Binding CanCancel, Converter={StaticResource Bool}}"/>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding State}" Foreground="#A3D7C7" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,9"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="↑" Padding="10,6" Margin="0,0,6,0" Click="MoveUp_Click" ToolTip="Przenieś wcześniej" Visibility="{Binding CanMove, Converter={StaticResource Bool}}"/>
              <Button Content="Anuluj" Padding="11,6" Click="Cancel_Click" Visibility="{Binding CanCancel, Converter={StaticResource Bool}}"/>
              <Button Content="Ponów" Padding="11,6" Click="Retry_Click" Visibility="{Binding CanRetry, Converter={StaticResource Bool}}"/>
              <Button Content="Otwórz" Padding="11,6" Margin="0,0,6,0" Click="OpenFile_Click" Visibility="{Binding IsDone, Converter={StaticResource Bool}}"/>
              <Button Content="Folder" Padding="11,6" Click="OpenJobFolder_Click" Visibility="{Binding IsDone, Converter={StaticResource Bool}}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="SingleGroupRow"><ContentPresenter Content="{Binding SingleJob}" ContentTemplate="{StaticResource JobRow}"/></DataTemplate>
    <DataTemplate x:Key="AlbumGroupRow">
      <Border Background="#161F2E" BorderBrush="#34415B" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,13">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Tag="ToggleGroup" Click="ToggleGroup_Click" Background="Transparent" Padding="0" HorizontalContentAlignment="Stretch" ToolTip="Rozwiń lub zwiń listę utworów" AutomationProperties.Name="{Binding Title}">
              <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="3"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#222D41"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="#222D41"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="47"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                <Border Background="#352F4C" CornerRadius="10" Width="37" Height="43" VerticalAlignment="Top"><TextBlock Text="♫" FontSize="25" Foreground="#C5ACFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="3,0,8,0"><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Metadata}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Arrow}" FontSize="25" Foreground="#FFB369" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Border Grid.Column="1" Background="#253438" CornerRadius="8" Padding="10,5" VerticalAlignment="Top" Margin="12,3,0,0"><TextBlock Text="{Binding Status}" Foreground="#A3D7C7" FontSize="11"/></Border>
          </Grid>
          <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#D0DBEB" TextWrapping="Wrap" Margin="3,15,0,9"/>
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Visibility="{Binding HasPending, Converter={StaticResource Bool}}" ToolTip="Postęp względem liczby utworów, nie rozmiaru plików"/>
          <TextBlock Text="{Binding Activity}" Foreground="#99ACC7" FontSize="12" Margin="3,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Activity}"/>
          <WrapPanel HorizontalAlignment="Right" Margin="0,13,0,0">
            <Button Content="Folder albumu" Tag="GroupFolder" Click="OpenGroupFolder_Click" Padding="12,7" Margin="0,0,7,0" FontSize="12"/>
            <Button Content="Anuluj pozostałe" Tag="CancelGroup" Click="CancelGroup_Click" Padding="12,7" FontSize="12" Visibility="{Binding CanCancelGroup, Converter={StaticResource Bool}}"/>
            <Button Content="Ponów nieudane" Tag="RetryGroup" Click="RetryGroup_Click" Padding="12,7" FontSize="12" Visibility="{Binding CanRetryGroup, Converter={StaticResource Bool}}"/>
          </WrapPanel>
          <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Bool}}" Margin="0,16,0,0">
            <Border Height="1" Background="#34415B" Margin="0,0,0,14"/>
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource JobRow}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="GroupedRow"><ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource SingleGroupRow}"/><Style.Triggers><DataTrigger Binding="{Binding IsAlbum}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource AlbumGroupRow}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl></DataTemplate>
  </Window.Resources>
  <Grid Background="{StaticResource Bg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101621" BorderBrush="#232B3B" BorderThickness="0,0,1,0">
      <Grid Margin="18,28,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,37"><StackPanel Orientation="Horizontal"><Border Background="#FFB369" CornerRadius="10" Width="36" Height="36"><TextBlock Text="↓" FontSize="28" Foreground="#211A17" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/></Border><TextBlock Text="LinkDrop" FontSize="23" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="MAŁY LINK. WIELKIE MOŻLIWOŚCI." FontSize="8" Foreground="#798AA3" Margin="1,13,0,0"/></StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="TWOJA BIBLIOTEKA" FontSize="10" Foreground="#65768F" FontWeight="SemiBold" Margin="16,0,0,12"/>
          <Button x:Name="NavHome" Content="⌂     Home" Style="{StaticResource Nav}" Tag="Home" Click="Navigate_Click"/>
          <Button x:Name="NavQueue" Style="{StaticResource Nav}" Tag="Queue" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="☷     Kolejka" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Border Background="#2F394D" CornerRadius="5" Padding="6,1" Margin="13,0,0,0"><TextBlock Text="{Binding PendingCount}" FontSize="11"/></Border></StackPanel></Button>
          <Button x:Name="NavHistory" Content="◷     Historia" Style="{StaticResource Nav}" Tag="History" Click="Navigate_Click"/>
          <Button x:Name="NavLogs" Content="≡     Logi i debug" Style="{StaticResource Nav}" Tag="Logs" Click="Navigate_Click"/>
          <Border Height="1" Background="#273043" Margin="12,22"/>
          <Button x:Name="NavSettings" Content="⚙     Ustawienia" Style="{StaticResource Nav}" Tag="Settings" Click="Navigate_Click"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#192433" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="●  Tylko na Twoim komputerze" FontSize="10" Foreground="#A3D7C7"/><TextBlock Text="Bez konta. Po prostu pobieraj." FontSize="10" Foreground="#8495AD" Margin="0,7,0,12"/><TextBlock Text="LINKDROP / 1.2" FontSize="9" Foreground="#627590"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="34,25,34,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22"><StackPanel><TextBlock x:Name="PageEyebrow" Text="TWOJE MEDIA, POD RĘKĄ" FontSize="10" FontWeight="SemiBold" Foreground="#A89EC7"/><TextBlock x:Name="PageTitle" Text="Zapisz coś dobrego." FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#192B29" CornerRadius="15" Padding="12,7"><TextBlock Text="{Binding ToolsStatus}" Foreground="#A3D7C7" FontSize="11"/></Border></Grid>
      <ScrollViewer Grid.Row="1" x:Name="PageScroll">
        <Grid Margin="0,0,3,20">
          <StackPanel x:Name="HomePage">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid><TextBlock Text="ZACZNIJ OD LINKU" Style="{StaticResource Caption}"/><TextBlock Text="01 / WYBIERZ MATERIAŁ" HorizontalAlignment="Right" FontSize="9" Foreground="#6F8099"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UrlInput" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" ToolTip="Link do filmu lub utworu (HTTP / HTTPS)" AutomationProperties.Name="Link do materiału" KeyDown="Url_KeyDown"/><TextBlock Text="Wklej link do filmu lub utworu…" Foreground="#65758D" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Url}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Column="1" Content="Wklej" Margin="8,0" Click="Paste_Click"/><Button x:Name="InspectButton" Grid.Column="2" Content="{Binding InspectLabel}" IsEnabled="{Binding CanInspect}" Click="Inspect_Click"/></Grid>
                <Border Margin="0,18,0,0" Background="#101725" CornerRadius="12" Padding="14">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#2C2844" CornerRadius="8" Height="64" ClipToBounds="True"><Grid><TextBlock Text="♫" FontSize="36" Foreground="#C3ABFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="PreviewImage" Stretch="UniformToFill"/></Grid></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="17,0,0,0"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Meta}" Foreground="#8799B2" FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <Border x:Name="PlaylistPanel" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsPlaylist, Converter={StaticResource Bool}}">
              <StackPanel>
                <Grid><StackPanel><TextBlock Text="PLAYLISTA / ALBUM" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectionSummary}" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SelectAllButton" Content="Wszystkie" Click="SelectAll_Click" Padding="12,8"/><Button x:Name="SelectNoneButton" Content="Żadne" Click="SelectNone_Click" Padding="12,8" Margin="8,0,0,0"/></StackPanel></Grid>
                <ScrollViewer MaxHeight="220" Margin="0,16,0,12">
                  <ItemsControl ItemsSource="{Binding Playlist}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="#293244" BorderThickness="0,0,0,1" Padding="0,8">
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Available}" HorizontalContentAlignment="Stretch" Margin="0" AutomationProperties.Name="{Binding Title}">
                        <StackPanel Margin="8,0,0,0"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                      </CheckBox>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
                <CheckBox Content="Podfolder z nazwą playlisty" IsChecked="{Binding PlaylistSubfolder}" Margin="0,5"/>
                <TextBlock Text="{Binding PlaylistWarning}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,20"><TextBlock Text="TAK, JAK LUBISZ" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AudioButton" Content="♫  Audio" Padding="18,9" Click="Audio_Click"/><Button x:Name="VideoButton" Content="▶  Wideo" Padding="18,9" Margin="7,0,0,0" Click="Video_Click"/></StackPanel></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FORMAT PLIKU" Style="{StaticResource Caption}"/><ComboBox x:Name="FormatSelect" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format, Mode=OneWay}" SelectionChanged="Format_SelectionChanged" AutomationProperties.Name="Format pliku"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="JAKOŚĆ" Style="{StaticResource Caption}"/><ComboBox x:Name="QualitySelect" ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality, Mode=OneWay}" SelectionChanged="Quality_SelectionChanged" AutomationProperties.Name="Jakość"/></StackPanel></Grid>
                <TextBlock Text="{Binding FormatHint}" Foreground="#7F91AA" FontSize="11" Margin="0,12,0,20" TextWrapping="Wrap"/>
                <TextBlock Text="FOLDER ZAPISU" Style="{StaticResource Caption}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Folder zapisu"/><Button Content="Wybierz…" Grid.Column="1" Margin="8,0,0,0" Click="ChooseFolder_Click"/></Grid>
                <Border Height="1" Background="#293244" Margin="0,21,0,19"/>
                <WrapPanel HorizontalAlignment="Right"><Button x:Name="AddButton" Content="{Binding AddLabel}" IsEnabled="{Binding CanSubmit}" Click="Add_Click" Margin="0,0,10,0"/><Button x:Name="DownloadButton" Content="{Binding DownloadLabel}" IsEnabled="{Binding CanSubmit}" Style="{StaticResource Primary}" Click="Download_Click" Padding="22,12"/></WrapPanel>
              </StackPanel>
            </Border>
            <Grid Margin="0,24,0,13"><TextBlock Text="Następne w kolejce" FontSize="16" FontWeight="SemiBold"/><Button Content="Zobacz wszystko  →" Tag="Queue" Click="Navigate_Click" Background="Transparent" Foreground="#FFB369" FontSize="11" Padding="0" HorizontalAlignment="Right"/></Grid>
            <Border BorderBrush="#293244" BorderThickness="1" CornerRadius="12" Padding="20" Visibility="{Binding EmptyPending, Converter={StaticResource Bool}}"><TextBlock Text="Jeszcze tu cicho. Dodaj pierwszy link, a zajmiemy się resztą." Foreground="#8799B2" FontSize="12"/></Border>
            <ItemsControl ItemsSource="{Binding HomeGroups}" ItemTemplate="{StaticResource GroupedRow}"/>
          </StackPanel>
          <StackPanel x:Name="QueuePage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><Grid><TextBlock Text="Jedno po drugim." FontSize="22" FontWeight="SemiBold"/><Button Content="{Binding QueueButton}" Click="ToggleQueue_Click" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding QueueHint}" Foreground="#98A9BF" Margin="0,15,0,0"/><TextBlock Text="Wstrzymanie kolejki pozwala dokończyć aktywny plik." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding EmptyPending, Converter={StaticResource Bool}}"><StackPanel Margin="0,35"><TextBlock Text="↓" FontSize="42" Foreground="#FFB369" HorizontalAlignment="Center"/><TextBlock Text="Kolejka jest pusta" FontSize="22" HorizontalAlignment="Center" Margin="0,10"/><TextBlock Text="Dodaj materiał na ekranie Home." Foreground="#97A5BB" HorizontalAlignment="Center"/></StackPanel></Border>
            <ItemsControl x:Name="QueueGroupList" ItemsSource="{Binding QueueGroups}" ItemTemplate="{StaticResource GroupedRow}"/>
          </StackPanel>
          <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
            <Grid Margin="0,0,0,20"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CompletedCount}" FontSize="28" Foreground="#FFB369" FontWeight="SemiBold"/><TextBlock Text="zapisanych materiałów" Foreground="#97A5BB" Margin="12,0,0,4" VerticalAlignment="Bottom"/></StackPanel><Button Content="Otwórz folder pobrań" Click="OpenFolder_Click" HorizontalAlignment="Right"/></Grid>
            <Border Style="{StaticResource Card}" Visibility="{Binding EmptyHistory, Converter={StaticResource Bool}}"><StackPanel Margin="0,35"><TextBlock Text="Twoja kolekcja zaczyna się tutaj." FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Zakończone i przerwane zadania pojawią się w tym miejscu." Foreground="#97A5BB" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Border>
            <ItemsControl x:Name="HistoryGroupList" ItemsSource="{Binding HistoryGroups}" ItemTemplate="{StaticResource GroupedRow}"/>
          </StackPanel>
          <StackPanel x:Name="LogsPage" Visibility="Collapsed">
            <Grid Margin="0,0,0,15"><CheckBox Content="Szczegółowy debug dla kolejnych pobrań" IsChecked="{Binding Debug}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Kopiuj" Click="CopyLogs_Click" Margin="0,0,8,0"/><Button Content="Zapisz logi…" Click="ExportLogs_Click"/></StackPanel></Grid>
            <TextBlock Text="Ostatnie 700 komunikatów · plik logów obracany po 2 MB" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#B2C4D9" Height="470" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Logi aplikacji"/>
          </StackPanel>
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Twoje ustawienia" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Format i jakość wybrane na Home zapamiętuję automatycznie." Foreground="#97A5BB" Margin="0,9,0,24"/><TextBlock Text="DOMYŚLNY FOLDER" Style="{StaticResource Caption}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Wybierz…" Grid.Column="1" Margin="8,0,0,0" Click="ChooseFolder_Click"/></Grid><Button Content="Zapisz ustawienia" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SaveSettings_Click"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Silnik pobierania" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="yt-dlp + FFmpeg + Deno" Foreground="#BBA5FF" Margin="0,10,0,12"/><TextBlock Text="Gdy serwis zmieni sposób udostępniania materiałów, aktualizacja yt-dlp może przywrócić pobieranie." Foreground="#97A5BB" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Sprawdź aktualizację yt-dlp" Click="Update_Click"/><Button Content="Folder danych i logów" Click="OpenData_Click" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
            <TextBlock Text="LinkDrop 1.2 · aplikacja prywatna na Windows&#10;Historia i ustawienia są przechowywane lokalnie. Pobieranie łączy się z wybranym serwisem.&#10;Materiały, playlisty i albumy obsługiwane przez yt-dlp. Bez logowania i DRM." Foreground="#71839E" FontSize="12" TextWrapping="Wrap" LineHeight="23" Margin="4,20,0,0"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="#283143" BorderThickness="0,1,0,0" Padding="0,13,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Notice}" Foreground="#A7B5C9" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"/><TextBlock Grid.Column="1" Text="●  LOKALNIE" Foreground="#6C827F" FontSize="9" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
